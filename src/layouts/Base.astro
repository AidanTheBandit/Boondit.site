---
import { ClientRouter } from 'astro:transitions';
import Rays from '../components/Rays.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  desc?: string;
  path?: string;
  foot?: boolean;
}

const {
  title = 'Boondit',
  desc = 'Tools for hardware that shouldn\'t still work.',
  path = Astro.url.pathname,
  foot = true,
} = Astro.props;

const nav: [string, string, 'blog' | 'projects' | 'rabbit' | 'github'][] = [
  ['blog', '/blog', 'blog'],
  ['projects', '/projects', 'projects'],
  ['rabbit', '/tools/', 'rabbit'],
  ['github', 'https://github.com/AidanTheBandit', 'github'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Boondit" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Boondit" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class={path === '/' ? 'home' : 'inner'}>
    <Rays />

    <div class="sheet">
      <div class="strip">
        <a class="mark" href="/">
          <Icon name="brand" size={18} />
          <span>boondit</span>
        </a>
        <nav>
          {nav.map(([label, href, icon]) => (
            <a
              href={href}
              aria-current={path === href ? 'page' : undefined}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener' : undefined}
            >
              <Icon name={icon} size={14} />
              <span>{label}</span>
            </a>
          ))}
        </nav>
      </div>
      <slot />

      {foot && (
        <div class="pfoot">
          <span class="idx">© 2026</span>
          <a class="coffee" href="https://buymeacoffee.com/boondit" target="_blank" rel="noopener">
            <Icon name="coffee" size={15} />
            buy me a coffee
          </a>
        </div>
      )}
    </div>
  </body>
</html>
