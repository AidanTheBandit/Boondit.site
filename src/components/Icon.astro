---
interface Props {
  name: 'brand' | 'blog' | 'projects' | 'rabbit' | 'github' | 'coffee' | 'arrow-left' | 'arrow-right' | 'external';
  size?: number;
  class?: string;
}

const { name, size = 15, class: cls = '' } = Astro.props;

const icons: Record<Props['name'], string> = {
  brand: `<rect x="2.5" y="2.5" width="19" height="19" rx="4.5" stroke="#2e2c2a" stroke-width="1.5"/>
          <circle cx="11.5" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="16.5" cy="12" r="1.75" fill="#ff0080" stroke="none"/>`,
  blog: `<path d="M5 4.5h10.5L19 8v11.5H5z"/>
         <path d="M15 4.5V8.5h4"/>
         <path d="M8.5 12h7M8.5 15.5h4.5"/>`,
  projects: `<rect x="4" y="4" width="6.5" height="6.5" rx="1"/>
             <rect x="13.5" y="4" width="6.5" height="6.5" rx="1"/>
             <rect x="4" y="13.5" width="6.5" height="6.5" rx="1"/>
             <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1" stroke="#995cd6"/>`,
  rabbit: `<rect x="4" y="4" width="16" height="16" rx="3"/>
           <rect x="6.5" y="6.5" width="8.5" height="11" rx="1"/>
           <circle cx="17.25" cy="8.5" r="0.9" fill="currentColor" stroke="none"/>
           <rect x="16.4" y="11" width="1.7" height="3.6" rx="0.85" fill="#ff0080" stroke="none"/>`,
  github: `<path d="M9.5 19c-4 1.2-4-2-5.5-2.5m11 4.5v-3.2a2.8 2.8 0 0 0-.8-2.2c2.7-.3 5.5-1.3 5.5-6a4.7 4.7 0 0 0-1.2-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.4 11.4 0 0 0-6 0C6.8 2.9 5.8 3.2 5.8 3.2a4.3 4.3 0 0 0-.1 3.2 4.7 4.7 0 0 0-1.2 3.2c0 4.7 2.8 5.7 5.5 6a2.8 2.8 0 0 0-.8 2.2V21"/>`,
  coffee: `<path d="M4.5 9h11v5.5a4.5 4.5 0 0 1-4.5 4.5H9a4.5 4.5 0 0 1-4.5-4.5z"/>
           <path d="M15.5 10.5H18a2 2 0 0 1 0 4h-2.5"/>
           <path d="M7.5 4.5v2M10.5 4v2.5M13.5 4.5v2"/>`,
  'arrow-left': `<path d="M19 12H5.5"/><path d="M11 6.5L5.5 12 11 17.5"/>`,
  'arrow-right': `<path d="M5 12h13.5"/><path d="M13 6.5L18.5 12 13 17.5"/>`,
  external: `<path d="M8 16L16.5 7.5"/><path d="M10.5 7.5h6v6"/>`,
};
---

<svg
  class={`ui-ic ${cls}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
