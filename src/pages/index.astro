---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { projects } from '../data/projects';
---

<Base>
  <main id="home">
    <div class="intro">
      <div class="portrait">
        <img src="/portrait.png" alt="Dithered portrait of Boondit" width="720" height="720" />
      </div>
      <div class="lede">
        <h1>Boondit<span>.</span></h1>
        <p>i make-a the code</p>
      </div>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <a class="door" href={`/projects/${p.id}/`} aria-label={p.name}>
          <span class="ic">
            <Mark id={p.mark} vtn={`mark-${p.id}`} />
          </span>
          <span class="lbl">{p.name}</span>
        </a>
      ))}
    </div>
  </main>
</Base>
