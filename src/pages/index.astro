---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { projects } from '../data/projects';
---

<Base>
  <main id="home">
    <div class="intro">
      <div class="portrait-wrap">
        <div class="portrait" id="portraitStage" title="Hold to compare original">
          <img id="portraitImg" src="/portrait.png" alt="Dithered portrait of Boondit" width="720" height="720" />
          <canvas id="portraitAscii" aria-hidden="true"></canvas>
        </div>
        <div class="portrait-modes" role="group" aria-label="Portrait ASCII style">
          <button type="button" class="pmode active" data-pmode="classic">classic</button>
          <button type="button" class="pmode" data-pmode="braille">braille</button>
          <button type="button" class="pmode" data-pmode="raw">raw</button>
        </div>
      </div>
      <div class="lede">
        <h1>Boondit<span>.</span></h1>
        <p>i make-a the code</p>
      </div>
    </div>

    <style>
      .portrait-wrap {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      #portraitStage {
        position: relative;
        overflow: hidden;
      }
      #portraitAscii {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        background: #0a0a0a;
        transition: opacity 0.14s ease;
        pointer-events: none;
      }
      #portraitStage.show-raw #portraitAscii {
        opacity: 0;
      }
      .portrait-modes {
        display: flex;
        gap: 6px;
      }
      .pmode {
        appearance: none;
        border: 1px solid #232323;
        background: #0a0a0a;
        color: #9a958d;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 14px;
        padding: 2px 8px;
        cursor: pointer;
      }
      .pmode.active,
      .pmode:hover {
        border-color: #ff0080;
        color: #e8e6e1;
      }
    </style>

    <script>
      function initPortraitAscii() {
        const stage = document.getElementById('portraitStage');
        const img = document.getElementById('portraitImg');
        const cv = document.getElementById('portraitAscii');
        if (!stage || !img || !cv || stage.dataset.asciiReady) return;
        stage.dataset.asciiReady = '1';
        const ctx = cv.getContext('2d');
        if (!ctx) return;
        const RAMP = ' .:-=+*#%@';
        let mode = 'classic';
        let luma = null;
        let sw = 0, sh = 0;

        function sampleImage() {
          if (!img.naturalWidth) return false;
          sw = 72;
          sh = 72;
          const off = document.createElement('canvas');
          off.width = sw;
          off.height = sh;
          const octx = off.getContext('2d');
          if (!octx) return false;
          octx.drawImage(img, 0, 0, sw, sh);
          const data = octx.getImageData(0, 0, sw, sh).data;
          luma = new Float32Array(sw * sh);
          for (let i = 0; i < sw * sh; i++) {
            const r = data[i * 4], g = data[i * 4 + 1], b = data[i * 4 + 2];
            luma[i] = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          }
          return true;
        }

        function render() {
          if (mode === 'raw') {
            stage.classList.add('show-raw');
            return;
          }
          stage.classList.remove('show-raw');
          if (!luma && !sampleImage()) return;
          const rect = stage.getBoundingClientRect();
          const cssW = Math.max(120, Math.round(rect.width || 240));
          const cssH = Math.max(120, Math.round(rect.height || 240));
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          if (cv.width !== cssW * dpr || cv.height !== cssH * dpr) {
            cv.width = cssW * dpr;
            cv.height = cssH * dpr;
          }
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.fillStyle = '#0a0a0a';
          ctx.fillRect(0, 0, cssW, cssH);
          const cw = 6, ch = 10;
          const cols = Math.floor(cssW / cw);
          const rows = Math.floor(cssH / ch);
          ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
          ctx.textBaseline = 'top';
          const sample = (x, y) => {
            const ix = Math.max(0, Math.min(sw - 1, Math.floor(x * sw)));
            const iy = Math.max(0, Math.min(sh - 1, Math.floor(y * sh)));
            return luma[iy * sw + ix];
          };
          for (let r = 0; r < rows; r++) {
            const ny = (r + 0.5) / rows;
            for (let c = 0; c < cols; c++) {
              const nx = (c + 0.5) / cols;
              const v = sample(nx, ny);
              let chOut = ' ';
              if (mode === 'classic') {
                const gx = sample(nx + 1 / sw, ny) - sample(nx - 1 / sw, ny);
                const gy = sample(nx, ny + 1 / sh) - sample(nx, ny - 1 / sh);
                if (Math.hypot(gx, gy) > 0.26) {
                  const ang = Math.atan2(gy, gx);
                  const a = Math.abs(ang);
                  chOut = (a < 0.4 || a > 2.74) ? '|' : (a > 1.17 && a < 1.97) ? '-' : (ang > 0 ? '\\' : '/');
                } else {
                  chOut = RAMP[Math.min(RAMP.length - 1, Math.floor(v * RAMP.length))];
                }
              } else {
                let bits = 0;
                const map = [[0,0,1],[0,1,2],[0,2,4],[1,0,8],[1,1,16],[1,2,32],[0,3,64],[1,3,128]];
                for (let k = 0; k < 8; k++) {
                  const sx = (c + (map[k][0] + 0.5) / 2) / cols;
                  const sy = (r + (map[k][1] + 0.5) / 4) / rows;
                  if (sample(sx, sy) > 0.38) bits |= map[k][2];
                }
                chOut = String.fromCharCode(0x2800 + bits);
              }
              if (chOut === ' ') continue;
              ctx.fillStyle = v > 0.78 ? '#ff0080' : v > 0.55 ? '#995cd6' : v > 0.28 ? '#e8e6e1' : '#4a4743';
              ctx.fillText(chOut, c * cw, r * ch);
            }
          }
          ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
          for (let y = 0; y < cssH; y += 3) ctx.fillRect(0, y, cssW, 1);
        }

        stage.querySelectorAll?.('.pmode');
        document.querySelectorAll('[data-pmode]').forEach((btn) => {
          btn.addEventListener('click', () => {
            mode = btn.dataset.pmode || 'classic';
            document.querySelectorAll('[data-pmode]').forEach((b) => b.classList.toggle('active', b === btn));
            render();
          });
        });
        stage.addEventListener('pointerdown', () => stage.classList.add('show-raw'));
        stage.addEventListener('pointerup', () => { if (mode !== 'raw') stage.classList.remove('show-raw'); });
        stage.addEventListener('pointerleave', () => { if (mode !== 'raw') stage.classList.remove('show-raw'); });

        if (img.complete) render();
        else img.addEventListener('load', render, { once: true });
        addEventListener('resize', render);
      }
      initPortraitAscii();
      document.addEventListener('astro:page-load', initPortraitAscii);
    </script>

    <div class="grid">
      {projects.map((p) => (
        <a class="door" href={`/projects/${p.id}/`} aria-label={p.name}>
          <span class="ic">
            <Mark id={p.mark} vtn={`mark-${p.id}`} />
          </span>
          <span class="lbl">{p.name}</span>
        </a>
      ))}
    </div>
  </main>
</Base>
