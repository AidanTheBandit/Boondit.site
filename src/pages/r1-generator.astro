---
import Base from '../layouts/Base.astro';
---

<Base title="R1 creation generator — Boondit" desc="Build the info.json and QR code for a Rabbit R1 creation." path="/r1-generator">
  <main class="page">
    <a class="back" href="/tools/" aria-label="Back to tools">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
      tools
    </a>

    <div class="gen">
      <!-- form -->
      <form class="panel form" id="creation-form" autocomplete="off">
        <h1>creation generator<span style="color:var(--pink)">.</span></h1>

        <label>plugin name <b>*</b>
          <input id="title" name="title" required placeholder="my creation">
        </label>

        <label>theme colour <b>*</b>
          <span class="colour">
            <input id="themeColor" name="themeColor" required value="#FF0080" maxlength="7">
            <input id="themeColorPicker" type="color" value="#FF0080">
          </span>
        </label>

        <label>website url <b>*</b>
          <input id="url" name="url" required placeholder="https://">
        </label>

        <label>description <b>*</b>
          <textarea id="description" name="description" rows="3" required>A community plugin for Rabbit R1.</textarea>
        </label>

        <div class="row">
          <label>author
            <input id="author" name="author" placeholder="optional">
          </label>
          <label>icon url
            <input id="iconUrl" name="iconUrl" placeholder="optional">
          </label>
        </div>

        <div class="actions">
          <label class="file">import json<input id="import-file" type="file" accept="application/json"></label>
          <button type="button" id="copy-btn" class="ghost">copy json</button>
        </div>
      </form>

      <!-- preview -->
      <section class="panel preview">
        <div class="qr-wrap">
          <div id="qr-code"><p class="waiting">waiting for details<span>_</span></p></div>
          <div class="qr-meta">
            <span id="preview-title">UNTITLED</span>
            <span id="preview-url">waiting-for-url</span>
          </div>
        </div>

        <textarea id="json-output" readonly spellcheck="false" aria-label="Generated JSON"></textarea>

        <div class="actions wrap">
          <button type="button" id="export-btn" class="primary" disabled>export to store</button>
          <button type="button" id="download-qr-btn" class="ghost" disabled>save image</button>
          <button type="button" id="download-btn" class="ghost" disabled>save json</button>
          <button type="button" id="expand-qr-btn" class="ghost hidden">fullscreen</button>
        </div>
      </section>
    </div>

    <!-- fullscreen qr -->
    <div id="qrModal" class="modal hidden">
      <div id="modalQrContainer" class="modal-inner"></div>
      <button type="button" id="closeModalBtn" class="modal-close">close esc</button>
    </div>
  </main>

  <script is:inline src="https://cdn.jsdelivr.net/npm/qr-code-styling@1.9.2/lib/qr-code-styling.min.js"></script>
  <script>
    const STORE_URL = 'https://creations.boondit.com';

    let currentData: any = null;
    let generatedDataUrl: string | null = null;
    let qrCode: any = null;

    function initGenerator() {
      const form = document.getElementById('creation-form') as HTMLFormElement | null;
      const jsonOutput = document.getElementById('json-output') as HTMLTextAreaElement | null;
      const qrContainer = document.getElementById('qr-code');
      if (!form || !jsonOutput || !qrContainer) return;
      if ((form as any).dataset.wired === '1') return;      // survives view transitions
      (form as any).dataset.wired = '1';

      const QR = (window as any).QRCodeStyling;
      if (!QR) { setTimeout(initGenerator, 200); return; }

      const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
      const title = $('title')!, url = $('url')!, desc = $('description')!;
      const themeColor = $('themeColor')!, picker = $('themeColorPicker')!;
      const iconUrl = $('iconUrl')!, author = $('author')!;
      const downloadBtn = $('download-btn')!, downloadQrBtn = $('download-qr-btn')!;
      const exportBtn = $('export-btn')!, expandBtn = $('expand-qr-btn')!;
      const copyBtn = $('copy-btn')!, importFile = $('import-file')!;
      const previewTitle = document.getElementById('preview-title')!;
      const previewUrl = document.getElementById('preview-url')!;

      const modal = document.getElementById('qrModal')!;
      const modalInner = document.getElementById('modalQrContainer')!;
      const closeBtn = document.getElementById('closeModalBtn')!;

      const clean = (v: string | null) => (v ?? '').replace(/[\n\r]/g, ' ').trim();

      function payload() {
        const data = {
          title: clean(title.value),
          url: clean(url.value),
          description: clean(desc.value),
          iconUrl: clean(iconUrl.value),
          themeColor: clean(themeColor.value),
          author: clean(author.value),
          screenshotUrl: '',
        };
        currentData = data;
        jsonOutput!.value = JSON.stringify(data, null, 2);
        previewTitle.textContent = data.title || 'UNTITLED';
        previewUrl.textContent = data.url || 'waiting-for-url';

        const ready = !!(data.title && data.url && data.themeColor && data.description);
        (downloadBtn as any).disabled = !ready;
        (downloadQrBtn as any).disabled = !ready;
        (exportBtn as any).disabled = !ready;
        expandBtn.classList.toggle('hidden', !ready);

        if (ready) drawWatermarkedQR(jsonOutput!.value); else waiting();
        return data;
      }

      function waiting() {
        qrContainer!.innerHTML = '<p class="waiting">waiting for details<span>_</span></p>';
        generatedDataUrl = null;
      }

      async function drawWatermarkedQR(dataStr: string) {
        const colour = (themeColor.value || '#000000').toUpperCase();
        const canvas = document.createElement('canvas');
        canvas.width = 340; canvas.height = 380;
        const ctx = canvas.getContext('2d')!;
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        qrCode = new QR({
          width: 300, height: 300, data: dataStr, margin: 10,
          qrOptions: { errorCorrectionLevel: 'H' },
          dotsOptions: { color: colour, type: 'rounded' },
          backgroundOptions: { color: '#ffffff' },
        });

        const blob = await qrCode.getRawData('png');
        const img = new Image();
        img.src = URL.createObjectURL(blob);
        await new Promise<void>((r) => (img.onload = () => r()));
        ctx.drawImage(img, 20, 20, 300, 300);

        ctx.fillStyle = '#666666';
        ctx.font = 'bold 14px Arial';
        ctx.textAlign = 'center';
        const t = (title.value || '').toUpperCase();
        ctx.fillText(t ? `${t} | BOONDIT.SITE` : 'BOONDIT.SITE', canvas.width / 2, 355);

        qrContainer!.innerHTML = '';
        qrContainer!.appendChild(canvas);
        generatedDataUrl = canvas.toDataURL('image/png');
      }

      function exportUrl(data: any) {
        const json = JSON.stringify({
          title: data.title, url: data.url, description: data.description,
          themeColor: data.themeColor, author: data.author,
          iconUrl: data.iconUrl, screenshotUrl: data.screenshotUrl,
        });
        const b64 = btoa(unescape(encodeURIComponent(json)))
          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        return `${STORE_URL}/dashboard/new?prefill=${b64}`;
      }

      form.addEventListener('input', payload);

      picker.addEventListener('input', () => {
        themeColor.value = picker.value.toUpperCase();
        payload();
      });
      themeColor.addEventListener('input', () => {
        if (/^#[0-9a-fA-F]{6}$/.test(themeColor.value)) picker.value = themeColor.value;
      });

      copyBtn.addEventListener('click', async () => {
        jsonOutput.select();
        try { await navigator.clipboard.writeText(jsonOutput.value); } catch { document.execCommand('copy'); }
        const old = copyBtn.textContent;
        copyBtn.textContent = 'copied';
        setTimeout(() => (copyBtn.textContent = old), 1600);
      });

      downloadBtn.addEventListener('click', () => {
        const blob = new Blob([jsonOutput.value], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'info.json';
        a.click();
      });

      downloadQrBtn.addEventListener('click', () => {
        if (!generatedDataUrl) return;
        const a = document.createElement('a');
        a.href = generatedDataUrl;
        a.download = `${title.value || 'creation'}-qr.png`;
        a.click();
      });

      exportBtn.addEventListener('click', () => {
        if (!currentData) return;
        window.open(exportUrl(currentData), '_blank', 'noopener');
      });

      importFile.addEventListener('change', () => {
        const file = importFile.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const json = JSON.parse(String(e.target?.result));
            const map: Record<string, HTMLInputElement> = {
              title, description: desc, iconUrl, themeColor, author, url,
            };
            for (const [k, el] of Object.entries(map)) if (json[k] !== undefined) el.value = json[k];
            payload();
          } catch { alert('Invalid JSON'); }
        };
        reader.readAsText(file);
      });

      // fullscreen
      const openModal = () => {
        if (!jsonOutput.value) return;
        modalInner.innerHTML = '';
        modal.classList.remove('hidden');
        new QR({
          width: 500, height: 500, data: jsonOutput.value,
          dotsOptions: { color: themeColor.value || '#000000', type: 'rounded' },
          backgroundOptions: { color: '#ffffff' },
        }).append(modalInner);
      };
      const closeModal = () => modal.classList.add('hidden');
      expandBtn.addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

      payload();
    }

    document.addEventListener('astro:page-load', initGenerator);
    if (document.readyState !== 'loading') initGenerator();
    else document.addEventListener('DOMContentLoaded', initGenerator);
  </script>

  <style>
    .gen {
      flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr;
      background: rgba(10, 10, 10, .93);
    }
    .panel { padding: 34px 40px 44px; overflow-y: auto; }
    .preview { border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 18px; padding-top: 46px; }

    .form h1 { font-size: clamp(26px, 3vw, 40px); letter-spacing: -.045em; font-weight: 800; line-height: 1; margin-bottom: 24px; }

    label { display: block; margin-bottom: 14px; font-family: var(--mono); font-size: 9.5px;
            letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
    label b { color: var(--pink); font-weight: 400; }
    input, textarea {
      width: 100%; margin-top: 7px; padding: 10px 11px;
      background: #0f0f0f; border: 1px solid var(--line); color: var(--ink);
      font-family: var(--mono); font-size: 12px; letter-spacing: .02em;
      resize: vertical; transition: border-color .2s;
    }
    input:focus, textarea:focus { outline: 0; border-color: var(--pink); }
    .colour { display: flex; gap: 8px; align-items: stretch; }
    .colour input[type="color"] { width: 44px; padding: 4px; cursor: pointer; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .actions {
      display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
      gap: 10px; margin-top: 18px;
    }
    .actions.wrap { margin-top: auto; }
    button, .file {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 10px 14px; border: 1px solid var(--line);
      font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
      color: var(--dim); cursor: pointer; transition: .2s var(--ease); background: none;
    }
    button:hover:not(:disabled), .file:hover { color: var(--ink); border-color: #3a3a3a; }
    button:disabled { opacity: .35; cursor: not-allowed; }
    .primary { border-color: var(--pink); color: var(--ink); background: rgba(255, 0, 128, .09); }
    .primary:hover:not(:disabled) { background: var(--pink); color: #0a0a0a; }
    .file { position: relative; }
    .file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }

    .qr-wrap { display: flex; flex-direction: column; align-items: center; gap: 12px; align-self: center; }
    #qr-code canvas, #qr-code img { width: 100%; max-width: 340px; height: auto; image-rendering: pixelated; }
    #qr-code {
      width: 340px; height: 380px; max-width: 100%;
      display: flex; align-items: center; justify-content: center;
      border: 1px dashed var(--line);
    }
    #qr-code canvas, #qr-code img { border: 0; }
    .qr-meta { width: 100%; max-width: 340px; display: flex; justify-content: space-between; gap: 14px;
               font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
    .waiting { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
               color: var(--faint); margin: 0; }
    .waiting span { animation: blink 1.4s steps(2, end) infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    #json-output { flex: 0 0 auto; height: 190px; font-size: 11px; line-height: 1.6; color: #b9b5ad; }

    .modal { position: fixed; inset: 0; z-index: 60; background: rgba(5, 5, 5, .94);
             display: flex; align-items: center; justify-content: center; }
    .modal.hidden, .hidden { display: none; }
    .modal-inner { background: #fff; padding: 16px; }
    .modal-close { position: absolute; top: 20px; right: 24px; }

    @media (max-width: 900px) {
      .gen { grid-template-columns: 1fr; }
      .preview { border-left: 0; border-top: 1px solid var(--line); }
      .panel { padding: 22px 18px 30px; }
      .row { grid-template-columns: 1fr; }
    }
  </style>
</Base>
