---
import Base from '../layouts/Base.astro';

type Item = { name: string; desc: string; href: string; where: string; local?: boolean };

const tools: Item[] = [
  {
    name: 'r1-create sdk',
    desc: 'JS/TS SDK for building R1 plugins: hardware access, AI helpers, UI primitives.',
    href: 'https://www.npmjs.com/package/r1-create',
    where: 'npm',
  },
  {
    name: 'creations qr',
    desc: 'Fill in a creation once and get the info.json plus a QR code the R1 camera can scan.',
    href: '/r1-generator/',
    where: 'here',
    local: true,
  },
];

const creations: Item[] = [
  { name: 'r1-anywhere', desc: 'Runs on the R1, exposes the device for remote control and API work.', href: 'https://r1a.boondit.site', where: 'web' },
  { name: 'r1-walky', desc: 'Peer-to-peer walkie talkie over WebRTC.', href: 'https://github.com/AidanTheBandit/R1-Walky', where: 'github' },
  { name: 'rabbit raycast', desc: 'A Doom-style 3D raycasting engine written for the R1.', href: 'https://github.com/AidanTheBandit/Rabbit-Raycast', where: 'github' },
];

const sections = [
  { title: 'tools', items: tools },
  { title: 'creations', items: creations },
];
---

<Base title="Rabbit R1 — Boondit" desc="Tools and creations for the Rabbit R1." path="/tools">
  <main class="page">
    <a class="back" href="/" aria-label="Back to work">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
      back
    </a>

    <div class="logs">
      <h1>R1<span style="color:var(--pink)">.</span></h1>

      {sections.map((s) => (
        <section class="group">
          <h2>{s.title}</h2>
          {s.items.map((t) => (
            <a class="post" href={t.href} target={t.local ? undefined : '_blank'} rel={t.local ? undefined : 'noopener'}>
              <time>{t.where}</time>
              <div>
                <h3>{t.name}</h3>
                <p>{t.desc}</p>
              </div>
              <span class="arrow">→</span>
            </a>
          ))}
        </section>
      ))}
    </div>
  </main>
</Base>

<style>
  .group { margin: 30px 0 32px; }
  .group:first-of-type { margin-top: 18px; }
  .group h2 {
    display: flex; align-items: center; gap: 9px;
    font-family: var(--mono); font-size: 9.5px; letter-spacing: .2em; text-transform: uppercase;
    color: var(--ink); font-weight: 400; margin-bottom: 12px;
  }
  .group h2::before { content: ""; width: 5px; height: 5px; background: var(--pink); }
  .post h3 { font-size: 19px; font-weight: 650; letter-spacing: -.015em; }
  .post p { margin-top: 5px; font-size: 13px; color: var(--dim); max-width: 60ch; }
  .post time { text-transform: uppercase; }
</style>
